# macOS
.DS_Store

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment and local config
.env
.env.*
!.env.example
# Candidate configs contain plaintext API keys; keep them out of Git.
config/candidate_discovery_agent/*/*_deepseek.json
config/candidate_discovery_agent/*/*_gpt.json
# Independent NER experiment configs contain local API keys.
config/ner_agent/*/*.json

# Logs
*.log

# Generated predictions
*_predictions.jsonl
*.jsonl.bak.*
baseline/llm_predictions.jsonl

# Result files are selected explicitly for each release.
result/**

# Local experiment utilities and development checks
run_full_shard.py
run_prefix_subshard.py
run_variant_shard.py
tests/
bioDataset/sample_dev_500.py
figure/*.pdf
*.lock
*.tmp

# Local vector databases / generated RAG indexes
rag/vector_db/
chroma/
*.sqlite3

# Jupyter
.ipynb_checkpoints/

# Local API keys
APIkey

# Archived documentation
docs/archive/
expert_agent/DESIGN.md
# Exclude credential-bearing historical log
/result/baseline/bc2gm/gpt-5.6-sol/bc2gm_gpt.log
